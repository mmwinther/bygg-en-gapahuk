{
  "name": "gapahuken",
  "version": "1.0.0",
  "private": true,
  "description": "En presentasjon om MVP — bygg en gapahuk, ikke et slott.",
  "scripts": {
    "dev": "marp --server . --theme theme.css",
    "present": "marp --preview --theme theme.css slides.md",
    "build": "marp --html --theme theme.css slides.md -o slides.html",
    "pdf": "marp --html --allow-local-files --theme theme.css --pdf slides.md -o gapahuken.pdf"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.5.1"
  },
  "engines": {
    "node": ">=18"
  }
}
